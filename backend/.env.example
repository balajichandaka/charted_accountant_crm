# Backend — local dev (backend/.env). Production uses docker-compose.yml on the prod branch.
# Copy to backend/.env and fill in values.

# Local npm dev against Docker Postgres:
#   ./scripts/compose.sh up -d db
#   DATABASE_URL="postgresql://ca:ca_password@localhost:5432/ca_app?schema=public"
#
# EC2 / Docker stack (prod branch): Postgres runs as the `db` service — no sslmode needed.
DATABASE_URL="postgresql://ca:ca_password@db:5432/ca_app?schema=public"

# Signs API JWTs returned to the frontend on login
JWT_SECRET="generate-a-long-random-string"

# Protects POST /api/cron/recurring (Render Cron Job or external scheduler)
CRON_SECRET="generate-a-long-random-string"

# Public Vercel app URL — used for CORS (comma-separated for preview + production)
FRONTEND_URL="https://your-app.vercel.app"

# Public app URL embedded in notification emails (usually same as FRONTEND_URL)
APP_URL="https://your-app.vercel.app"

# Email (SMTP) — platform-wide FALLBACK sender. Firms that set their own SMTP
# in Settings send from their own mailbox instead; this is used when they don't.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Alert from CA Charan <no-reply@example.com>"

# Encrypts per-firm SMTP app-passwords at rest (AES-256-GCM). 32-byte key as
# 64 hex chars or base64. Generate: openssl rand -hex 32
EMAIL_ENC_KEY=""
FIRM_CONTACT_EMAIL="vscharanco@gmail.com"
FIRM_CONTACT_PHONE="6302846943"
FIRM_ESCALATION_NAME="Sai Charan"
FIRM_ESCALATION_EMAIL="vscharanca@gmail.com"
FIRM_ESCALATION_PHONE="9566278894"

# Render sets PORT automatically; use 4000 locally
PORT="4000"

# Writable path for file uploads
UPLOAD_DIR="./uploads"

# Initial CA admin for first boot (docker compose / npm run db:seed)
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@cafirmops.in"
ADMIN_PASSWORD="change-me"

NODE_ENV="production"

# Log verbosity: debug | info | warn | error (default info). Use "debug" to trace requests.
LOG_LEVEL="info"


