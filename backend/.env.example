# Backend — Render Web Service (or local / Docker via backend/.env)
# Copy to backend/.env and fill in values.

# PostgreSQL (Render: link your Postgres service; append ?schema=public if missing)
# Render internal URL (backend + DB on Render): no sslmode needed
# External URL (local dev): add &sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public"

# Signs API JWTs returned to the frontend on login
JWT_SECRET="generate-a-long-random-string"

# Protects POST /api/cron/recurring (Render Cron Job or external scheduler)
CRON_SECRET="generate-a-long-random-string"

# Public Vercel app URL — used for CORS (comma-separated for preview + production)
FRONTEND_URL="https://your-app.vercel.app"

# Public app URL embedded in notification emails (usually same as FRONTEND_URL)
APP_URL="https://your-app.vercel.app"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CA Practice <no-reply@example.com>"

# Render sets PORT automatically; use 4000 locally
PORT="4000"

# Writable path for file uploads (Render: attach a persistent disk or uploads are ephemeral)
UPLOAD_DIR="./uploads"

# Set to true only for first local/Docker boot to load demo data — never on Render production
SEED_DB="false"

NODE_ENV="production"
