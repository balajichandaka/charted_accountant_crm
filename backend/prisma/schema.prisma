// CA Practice Management System — data model
// See docs/superpowers/specs and the approved plan for the domain model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CA
  MANAGER
  EMPLOYEE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Frequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum BillableType {
  BILLABLE
  NON_BILLABLE
}

// Informational invoice note only — NO payment/money logic in the system.
enum InvoiceStatusNote {
  NOT_APPLICABLE
  PENDING
  ISSUED
}

enum SubtaskStatus {
  TODO
  DONE
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  SUBTASK_TOGGLED
  TIME_LOGGED
  ATTACHMENT_ADDED
  UPDATED
  RECURRING_GENERATED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Users (CA + employees) — clients do NOT log in
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTickets    Ticket[]            @relation("TicketAssignee")
  managedTickets     Ticket[]            @relation("TicketManager")
  reportedTickets    Ticket[]            @relation("TicketReporter")
  assignedSubtasks   TicketSubtask[]
  comments           TicketComment[]
  timeEntries        TimeEntry[]
  uploadedAttachments Attachment[]
  activities         ActivityLog[]
  notifications      NotificationLog[]
  recurringSchedules RecurringSchedule[] @relation("ScheduleAssignee")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Clients (fields mirror the CA's requirement sheet, Sheet 2)
// ---------------------------------------------------------------------------

model Client {
  id              String   @id @default(cuid())
  name            String
  companyName     String?
  gstNumber       String?
  billTo          String?
  shipTo          String?
  rcm             Boolean  @default(false)
  creditPeriodDays Int?
  state           String?
  fullAddress     String?
  email           String?
  phone           String?
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tickets            Ticket[]
  recurringSchedules RecurringSchedule[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Category of works (GST, Income Tax, MCA Filings, ...)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  colorHex    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workTemplates WorkTemplate[]
  tickets       Ticket[]
}

// ---------------------------------------------------------------------------
// Work templates ("Task" catalog) + their ordered sub-tasks
// ---------------------------------------------------------------------------

model WorkTemplate {
  id                String       @id @default(cuid())
  name              String
  description       String?
  documentsRequired String?
  defaultFrequency  Frequency    @default(ONE_TIME)
  defaultBillable   BillableType @default(BILLABLE)
  defaultPriority   Priority     @default(MEDIUM)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subtasks           TemplateSubtask[]
  generatedTickets   Ticket[]
  recurringSchedules RecurringSchedule[]

  @@index([categoryId])
}

model TemplateSubtask {
  id         String @id @default(cuid())
  title      String
  order      Int

  templateId String
  template   WorkTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Tickets (instantiated from a template, with a snapshot of its sub-tasks)
// ---------------------------------------------------------------------------

model Ticket {
  id                String            @id @default(cuid())
  ticketNumber      Int               @unique @default(autoincrement())
  title             String
  description       String?
  status            TicketStatus      @default(OPEN)
  priority          Priority          @default(MEDIUM)
  frequency         Frequency         @default(ONE_TIME)
  documentsRequired String?
  billable          BillableType      @default(BILLABLE)
  invoiceStatus     InvoiceStatusNote @default(NOT_APPLICABLE)
  targetMinutes     Int?
  startDate         DateTime?
  dueDate           DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  clientId   String
  client     Client        @relation(fields: [clientId], references: [id])
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id])
  templateId String?
  template   WorkTemplate? @relation(fields: [templateId], references: [id])
  assigneeId String?
  assignee   User?         @relation("TicketAssignee", fields: [assigneeId], references: [id])
  managerId  String?
  manager    User?         @relation("TicketManager", fields: [managerId], references: [id])
  reporterId String
  reporter   User          @relation("TicketReporter", fields: [reporterId], references: [id])

  recurringScheduleId String?
  recurringSchedule   RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id])
  periodLabel         String?

  subtasks    TicketSubtask[]
  comments    TicketComment[]
  timeEntries TimeEntry[]
  attachments Attachment[]
  activities  ActivityLog[]

  @@unique([recurringScheduleId, periodLabel])
  @@index([status])
  @@index([assigneeId])
  @@index([managerId])
  @@index([clientId])
  @@index([categoryId])
}

model TicketSubtask {
  id          String        @id @default(cuid())
  title       String
  order       Int
  status      SubtaskStatus @default(TODO)
  completedAt DateTime?

  ticketId   String
  ticket     Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id])

  @@index([ticketId])
}

model TicketComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  parentId String?
  parent   TicketComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies  TicketComment[] @relation("CommentThread")

  attachments Attachment[]

  @@index([ticketId])
}

model TimeEntry {
  id           String   @id @default(cuid())
  minutes      Int
  startMinutes Int      @default(540)
  description  String?
  workDate     DateTime
  billable     Boolean  @default(true)
  createdAt    DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId, workDate])
}

model Attachment {
  id         String   @id @default(cuid())
  fileName   String
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  ticketId     String
  ticket       Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@index([commentId])
}

// ---------------------------------------------------------------------------
// Recurring schedules: (client + template + frequency) -> auto-generate tickets
// ---------------------------------------------------------------------------

model RecurringSchedule {
  id               String    @id @default(cuid())
  frequency        Frequency
  dayOfMonth       Int?
  dueOffsetDays    Int       @default(7)
  isActive         Boolean   @default(true)
  lastGeneratedFor DateTime?
  nextRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clientId   String
  client     Client       @relation(fields: [clientId], references: [id])
  templateId String
  template   WorkTemplate @relation(fields: [templateId], references: [id])
  assigneeId String?
  assignee   User?        @relation("ScheduleAssignee", fields: [assigneeId], references: [id])

  generatedTickets Ticket[]

  @@index([isActive, nextRunAt])
}

// ---------------------------------------------------------------------------
// Audit + notification logs
// ---------------------------------------------------------------------------

model ActivityLog {
  id        String       @id @default(cuid())
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id])
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}

model NotificationLog {
  id        String              @id @default(cuid())
  channel   NotificationChannel @default(EMAIL)
  subject   String
  status    NotificationStatus
  error     String?
  createdAt DateTime            @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  ticketId String?

  @@index([userId])
}
