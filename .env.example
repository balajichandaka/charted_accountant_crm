# Repo-root env for docker compose (EC2 production).
# Copy to .env on the server and set strong values before first deploy.
#
#   cp .env.example .env
#   nano .env

# Self-hosted Postgres (Docker volume pgdata on EC2 disk)
POSTGRES_USER=ca
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=ca_app

# Initial CA admin (created once on first boot when no CA user exists)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@cafirmops.in
ADMIN_PASSWORD=generate-a-strong-admin-password

# Public site URL (auth redirects, CORS, email links)
APP_PUBLIC_URL=https://cafirmops.in

# Host port for the frontend container (Nginx proxies to this)
APP_PORT=3000
