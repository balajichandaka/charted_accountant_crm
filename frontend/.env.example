# Frontend — EC2 Docker, Vercel, or local dev (frontend/.env)
# Copy to frontend/.env and fill in values.
# The frontend talks to the backend API only — no DATABASE_URL needed here.

# EC2 Docker: http://backend:4000 (internal compose network)
# Public API URL only if the browser calls the backend directly
BACKEND_URL="http://backend:4000"

# NextAuth session encryption — generate a long random string (independent of JWT_SECRET)
AUTH_SECRET="generate-a-long-random-string"

# Required on Vercel so Auth.js trusts the deployment host
AUTH_TRUST_HOST="true"

# Multi-tenant prod: leave AUTH_URL unset; AUTH_TRUST_HOST=true derives URL from Host.
# Do NOT set AUTH_URL=https://cafirmops.in — that redirects all firm subdomains to root.
# NEXT_PUBLIC_ROOT_DOMAIN=cafirmops.in

# Local dev only:
# NEXT_PUBLIC_DEFAULT_FIRM_SLUG=firm1
# Login at http://firm1.localhost:3001/login (ca@firm.test / password123 after seed)
